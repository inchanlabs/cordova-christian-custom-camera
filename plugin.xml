<?xml version="1.0" encoding="UTF-8"?>

<plugin
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-christian-custom-camera"
    version="1.0.0">

    <name>Christian Custom Camera</name>
    <description>Custom Cordova Camera Plugin</description>
    <license>Apache 2.0</license>
    <keywords>cordova,camera</keywords>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
        <engine name="cordova-android" version=">=10.0.0" />
    </engines>

    <!-- ================================================== -->
    <!-- JAVASCRIPT -->
    <!-- ================================================== -->

    <js-module
        src="www/Camera.js"
        name="Camera">

        <clobbers target="navigator.camera" />

    </js-module>


    <!-- ================================================== -->
    <!-- ANDROID -->
    <!-- ================================================== -->

    <platform name="android">

        <!-- Kotlin / AndroidX -->

        <preference
            name="GradlePluginKotlinEnabled"
            value="true" />

        <preference
            name="GradlePluginKotlinCodeStyle"
            value="official" />

        <preference
            name="AndroidXEnabled"
            value="true" />


        <!-- Camera permission only -->

        <config-file
            target="AndroidManifest.xml"
            parent="/manifest">

            <uses-permission
                android:name="android.permission.CAMERA" />

        </config-file>


        <!-- FileProvider -->

        <config-file
            target="AndroidManifest.xml"
            parent="/manifest/application">

            <provider
                android:name="com.christian.customcamera.FileProvider"
                android:authorities="${applicationId}.customcamera.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">

                <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/custom_camera_paths" />

            </provider>

        </config-file>


        <!-- Cordova Plugin Registration -->

        <config-file
            target="res/xml/config.xml"
            parent="/*">

            <feature name="CustomCamera">

                <param
                    name="android-package"
                    value="com.christian.customcamera.CameraLauncher" />

            </feature>

        </config-file>


        <!-- Kotlin Camera Launcher -->

        <source-file
            src="src/android/CameraLauncher.kt"
            target-dir="app/src/main/kotlin/com/christian/customcamera" />


        <!-- FileProvider -->

        <source-file
            src="src/android/FileProvider.java"
            target-dir="app/src/main/java/com/christian/customcamera" />


        <!-- FileProvider Paths -->

        <resource-file
            src="src/android/xml/custom_camera_paths.xml"
            target="app/src/main/res/xml/custom_camera_paths.xml" />


        <!-- AndroidX -->

        <framework
            src="androidx.core:core-ktx:1.13.1" />

    </platform>

</plugin>
