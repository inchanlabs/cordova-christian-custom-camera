<?xml version="1.0" encoding="UTF-8"?>

<plugin
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-christian-custom-camera"
    version="1.0.0">

    <name>Christian Custom Camera</name>
    <description>Custom Cordova Camera Plugin</description>
    <license>Apache-2.0</license>
    <keywords>cordova,camera</keywords>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
        <engine name="cordova-android" version=">=10.0.0" />
    </engines>

    <!-- JavaScript API -->
    <js-module
        src="www/Camera.js"
        name="Camera">

        <clobbers target="navigator.camera" />

    </js-module>

    <platform name="android">

        <!-- Camera permission -->
        <config-file
            target="AndroidManifest.xml"
            parent="/manifest">

            <uses-permission
                android:name="android.permission.CAMERA" />

        </config-file>

        <!-- Cordova native plugin registration -->
        <config-file
            target="config.xml"
            parent="/*">

            <feature name="CustomCamera">

                <param
                    name="android-package"
                    value="com.christian.customcamera.CameraLauncher" />

            </feature>

        </config-file>

        <!-- Kotlin implementation -->
        <source-file
            src="src/android/CameraLauncher.kt"
            target-dir="src/main/kotlin/com/christian/customcamera" />

        <!-- AndroidX -->
        <framework
            src="androidx.core:core-ktx:1.13.1" />

    </platform>

</plugin>
