<?xml version="1.0" encoding="UTF-8"?>
<plugin
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-christian-custom-camera"
    version="1.0.0">

    <name>Christian Custom Camera</name>
    <description>Custom Cordova Camera Plugin for OutSystems</description>
    <license>Apache-2.0</license>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
        <engine name="cordova-android" version=">=10.0.0" />
    </engines>

    <!-- JavaScript Module -->
    <js-module src="www/Camera.js" name="Camera">
        <clobbers target="plugins.ChristianCustomCamera" />
    </js-module>

    <!-- Android Platform Configuration -->
    <platform name="android">

        <!-- Cordova Plugin Registration -->
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="CustomCamera">
                <param
                    name="android-package"
                    value="com.christian.customcamera.CameraLauncher" />
            </feature>
        </config-file>

        <!-- Camera Permission -->
        <config-file
            target="AndroidManifest.xml"
            parent="/*"
            xmlns:android="http://schemas.android.com/apk/res/android">

            <uses-permission
                android:name="android.permission.CAMERA" />

        </config-file>

        <!-- FileProvider Paths -->
        <resource-file
            src="src/android/xml/camera_provider_paths.xml"
            target="app/src/main/res/xml/camera_provider_paths.xml" />

        <!-- FileProvider -->
        <edit-config
            file="app/src/main/AndroidManifest.xml"
            mode="merge"
            target="/manifest/application">

            <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.customcamera.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">

                <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/camera_provider_paths" />

            </provider>

        </edit-config>

        <!-- Kotlin Source -->
        <source-file
            src="src/android/CameraLauncher.kt"
            target-dir="app/src/main/java/com/christian/customcamera" />

    </platform>

</plugin>
