<?xml version="1.0" encoding="UTF-8"?>
<plugin
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-christian-custom-camera"
    version="1.0.0">

    <name>Christian Custom Camera</name>
    <description>Custom Cordova Camera Plugin</description>
    <license>Apache-2.0</license>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
        <engine name="cordova-android" version=">=10.0.0" />
    </engines>

    <!-- JavaScript Module -->
    <js-module src="www/Camera.js" name="Camera">
        <clobbers target="plugins.ChristianCustomCamera" />
    </js-module>

    <!-- Android Platform -->
    <platform name="android">

        <!-- Cordova Feature Registration -->
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="CustomCamera">
                <param name="android-package" value="com.christian.customcamera.CameraLauncher" />
            </feature>
        </config-file>

        <!-- Kotlin Source File Mapping -->
        <source-file
            src="src/android/CameraLauncher.kt"
            target-dir="src/com/christian/customcamera" />

        <framework src="org.jetbrains.kotlin:kotlin-stdlib:1.9.20" />

    </platform>

</plugin>
