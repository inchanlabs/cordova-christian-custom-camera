<?xml version="1.0" encoding="UTF-8"?>
<plugin
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-christian-custom-camera"
    version="1.0.0">

    <name>Christian Custom Camera</name>
    <description>Custom Cordova Camera Plugin for OutSystems</description>
    <license>Apache-2.0</license>

    <engines>
        <engine name="cordova" version=">=10.0.0" />
        <engine name="cordova-android" version=">=10.0.0" />
    </engines>

    <!-- JavaScript Module -->
    <js-module src="www/Camera.js" name="Camera">
        <clobbers target="plugins.ChristianCustomCamera" />
    </js-module>

    <!-- Android Platform Configuration -->
    <platform name="android">

        <!-- Config.xml Registration -->
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="CustomCamera">
                <param name="android-package" value="com.christian.customcamera.CameraLauncher" />
            </feature>
        </config-file>

        <!-- Manifest Permissions (Includes Android Namespace) -->
        <config-file target="AndroidManifest.xml" parent="/*" xmlns:android="http://schemas.android.com/apk/res/android">
            <uses-permission android:name="android.permission.CAMERA" />
        </config-file>

        <!-- Source File Path for Cordova Android 10+ -->
        <source-file
            src="src/android/CameraLauncher.kt"
            target-dir="app/src/main/java/com/christian/customcamera" />

        <config-file parent="/manifest/application" target="AndroidManifest.xml">
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/custom_camera_file_paths" />
    </provider>
</config-file>

<resource-file
    src="src/android/res/xml/custom_camera_file_paths.xml"
    target="app/src/main/res/xml/custom_camera_file_paths.xml" />

    </platform>

</plugin>
